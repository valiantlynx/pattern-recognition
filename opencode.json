{
	"$schema": "https://opencode.ai/config.json",
	"watcher": {
		"ignore": [
			"dist/**",
			".git/**",
            ".venv/**",
            "__pycache__/**",
		]
	},
	"instructions": [
		"CONTRIBUTING.md",
		"docs/guidelines.md",
		".cursor/rules/*.md",
		".github/instructions/*.md",
		".github/copilot-instructions.md"
	],
	"provider": {
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama",
			"options": {
				"baseURL": "http://192.168.38.157:9012/v1"
			},
			"models": {
				"qwen3-vl:32b": {
					"name": "Qwen3 VL 32B"
				},
				"gpt-oss:latest": {
					"name": "GPT OSS"
				},
				"gemma3:latest": {
					"name": "Gemma3 4B"
				},
				"qwen3.5:35b": {
					"name": "Qwen3.5 35B"
				},
				"glm-4.7-flash": {
					"name": "GLM 4.7 Flash"
				}
			}
		}
	},
	"model": "github-copilot/claude-opus-4.6",
	"mcp": {
		"playwright": {
			"command": ["npx", "-y", "@playwright/mcp@latest"],
			"type": "local"
		},
		"github": {
			"type": "remote",
			"headers": { "Authorization": "Bearer {env:GITHUB_PAT}" },
			"url": "https://api.githubcopilot.com/mcp/",
			"oauth": {
				"clientId": "{env:MADP_CLIENT_ID}",
				"clientSecret": "{env:MADP_CLIENT_SECRET}",
				"scope": "tools:read tools:execute"
			}
		}
	}
}